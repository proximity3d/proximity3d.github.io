ren":[["$","sup",null,{"children":"†"}],"Corresponding authors"]}]]}],["$","div",null,{"className":"affiliations","children":[["$","span","Centre for Perceptual and Interactive Intelligence",{"children":[["$","sup",null,{"children":1}],"Centre for Perceptual and Interactive Intelligence"]}],["$","span","Xiamen University",{"children":[["$","sup",null,{"children":2}],"Xiamen University"]}],["$","span","The Chinese University of Hong Kong",{"children":[["$","sup",null,{"children":3}],"The Chinese University of Hong Kong"]}],["$","span","The University of Manchester",{"children":[["$","sup",null,{"children":4}],"The University of Manchester"]}]]}],["$","div",null,{"className":"link-row","children":[["$","a","Paper",{"href":"https://arxiv.org/abs/2608.30344","target":"_blank","rel":"noreferrer","children":[["$","span",null,{"className":"link-icon","children":"▤"}],["$","span",null,{"children":"Paper"}]]}],["$","a","Code",{"href":"https://github.com/proximity3d/Proximity3D-Code","target":"_blank","rel":"noreferrer","children":[["$","span",null,{"className":"link-icon","children":"</>"}],["$","span",null,{"children":"Code"}]]}]]}]]}],["$","figure",null,{"className":"teaser","children":[["$","img",null,{"src":"/teaser-overview.webp","alt":"Overview of the Proximity3D pipeline"}],["$","figcaption",null,{"children":[["$","b",null,{"children":"Proximity3D"}]," reconstructs object geometry from pre-contact capacitive scans captured by a curved woven sensing manifold. Multi-view proximity fields are fused to recover a complete 3D mesh for downstream robotic applications."]}]]}],["$","section",null,{"className":"video-section","children":[["$","h2",null,{"children":"Fast-Forward Video"}],["$","video",null,{"controls":true,"playsInline":true,"preload":"metadata","children":[["$","source",null,{"src":"/proximity3d-fast-forward.mp4","type":"video/mp4"}],"Your browser does not support embedded videos."]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Abstract"}],["$","p",null,{"children":"Most shape reconstruction methods assume measurements defined over planar sensing domains, such as RGB images or depth maps. In this paper, we use a curved capacitive textile as a shape sensor, treating its surface as a non-planar sensing manifold. Each scan is represented as a capacitive proximity field on this manifold, induced by the interaction between the curved electrode layout and nearby object geometry."}],["$","p",null,{"children":"We introduce a multi-view feedforward reconstruction model that aggregates these fields across known sensor views and recovers the observed object shape. Simulated and physical experiments demonstrate robust reconstruction from capacitive proximity signals acquired on curved sensing surfaces, pointing toward a new route to robotic near-field geometric awareness via embodied sensing."}]]}],"$Ld","$Le","$Lf","$L10","$L11","$L12"]}]
