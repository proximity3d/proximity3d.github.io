d:["$","section",null,{"children":[["$","h2",null,{"children":"Capacitive Proximity on a Sensing Manifold"}],["$","p",null,{"children":"A woven capacitive textile conforms to a curved surface. Each channel has a known site, local electrode frame, and adjacency relation, providing the geometric structure used by the reconstruction model."}],["$","figure",null,{"className":"content-figure","children":[["$","img",null,{"src":"/sensing-manifold.webp","alt":"Curved woven capacitive sensing manifold and acquisition setup"}],["$","figcaption",null,{"children":"The sensing manifold is moved around the target without contact. Each view yields a capacitive proximity field defined on the curved electrode layout."}]]}]]}]
e:["$","section",null,{"children":[["$","h2",null,{"children":"Method"}],["$","figure",null,{"className":"content-figure","children":[["$","img",null,{"src":"/method-overview.webp","alt":"Proximity3D method architecture"}],["$","figcaption",null,{"children":"Manifold Sensing Attention aggregates local channel responses with the local electrode layout and tangent-frame geometry. A global module then fuses evidence across known views into a 3D latent representation for shape decoding."}]]}]]}]
