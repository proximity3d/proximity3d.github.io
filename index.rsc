10:["$","section",null,{"id":"real-world-results","className":"real-world-section","children":[["$","h2",null,{"children":"Real-World Results"}],["$","p",null,{"children":"The woven sensing manifold acquires multi-view proximity signals around each physical target, which Proximity3D uses to reconstruct the object mesh. The figure below is a schematic illustration of the real-world sensing process."}],["$","figure",null,{"className":"real-world-figure","children":["$","div",null,{"className":"real-world-scroll","children":["$","div",null,{"className":"real-world-composite","children":[["$","img",null,{"src":"/application-gallery.webp","alt":"Real-world capacitive sensing sequences and physical target objects"}],["$","div",null,{"id":"application-reconstructions","children":["$","$L14",null,{}]}]]}]}]}]]}]
